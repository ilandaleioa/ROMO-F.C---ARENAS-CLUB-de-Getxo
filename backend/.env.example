# URL del proyecto Supabase (REST endpoint base, sin /rest/v1)
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Service role key de Supabase - NUNCA exponer al frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Secreto usado para firmar el JWT de sesion (usa una cadena larga y aleatoria)
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Nombre de la cookie de sesion (opcional)
SESSION_COOKIE_NAME=romofc_session

# Puerto del backend
PORT=4000

# Origen permitido para CORS (URL del frontend en desarrollo)
FRONTEND_ORIGIN=http://localhost:5173

# "production" activa cookies "secure" (requiere HTTPS)
NODE_ENV=development
